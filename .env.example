# Koneksi Database PostgreSQL (Neon.tech / PostgreSQL)
# Contoh format koneksi dari Neon:
# DATABASE_URL="postgresql://neondb_owner:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://neondb_owner:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=
DIRECT_URL=

# Kata Sandi Rahasia untuk Keamanan Login
JWT_SECRET=kunci_rahasia_genbi_tegal_2024

# Penyimpanan Foto Bukti (Cloudinary Storage)
# Anda dapat mengisi CLOUDINARY_URL atau kombinasi 3 variabel di bawahnya:
# Contoh: cloudinary://123456789:abcdefgh@nama-cloud
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
